# ── Supabase Postgres (SQLAlchemy connection) ──────────────────────────────
# Get these from: Supabase Dashboard → Settings → Database → Connection string
# Pick "Transaction pooler" (port 6543). Use the username shown (usually postgres.<ref>).

user=postgres.YOUR_PROJECT_REF
password=YOUR_DB_PASSWORD
host=aws-0-<region>.pooler.supabase.com
port=6543
dbname=postgres

# ── Supabase Auth (REST/SDK client) ────────────────────────────────────────
# From: Settings → API → Project URL (base URL only — no /rest/v1/ suffix)
#        Settings → API → API keys → anon public key

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key
